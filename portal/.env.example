# Settings of the portal: copy to portal/.env (not in git) and fill in.
# The private ones (your address, the SMTP password) only live in portal/.env.

# Where new submissions and contact messages are sent
PORTAL_MAINTAINER_EMAIL=you@example.org

# Outgoing mail: the mailbox sending the emails (an Infomaniak email account, not an alias or a
# redirection). SMTP_PASSWORD is the password of that mailbox, not of your Infomaniak login.
# Without SMTP_HOST, emails are only written to the log.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=noreply@antadatabase.com
SMTP_PASSWORD=
SMTP_FROM=noreply@antadatabase.com

# Downloads of the Python package (db.sync()) in the statistics of the site: a GoatCounter API
# key allowed to record pageviews. Without it, they are only written to the log
PORTAL_GOATCOUNTER_KEY=

# Optional
# PORTAL_DATA=portal/data
# PORTAL_ORIGINS=https://antadatabase.com,http://localhost:5173
# PORTAL_MAX_GB=5
# PORTAL_SITE_URL=https://antadatabase.com
# PORTAL_GOATCOUNTER_URL=https://antadatabase.goatcounter.com

# Another copy of the portal (README.md, "A test copy"), deployed with
# PORTAL_ENV_FILE=.env.test PORTAL_SERVER_ENV_FILE=.env.server.test portal/deploy.sh, sets all of
# these in its own files (the official portal uses the values shown):
# PORTAL_DOMAIN=api.antadatabase.com
# PORTAL_SUBMISSIONS_BUCKET=antadatabase-submissions
# PORTAL_CONTACT_BUCKET=antadatabase-contact
# PORTAL_COMPILED_BUCKET=antadatabase-compiled
# PORTAL_REVIEW_BUCKET=antadatabase-review
# PORTAL_ORIGINS=https://antadatabase.com
